<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- The gyrophone simulator page's browser side, compiled to JavaScript by Fable:
         dotnet tool restore
         dotnet fable SirenePupitre/webfiles/simulateur-fable -o SirenePupitre/webfiles
       Produces simulateur-fable.js — ready to replace the inline <script> of
       simulateur.html with <script src="simulateur-fable.js"></script>. Not
       wired in yet. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WarningLevel>3</WarningLevel>
    <!-- FSharp.Core comes from paket (paket.references) -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Model.fs" />
    <Compile Include="Ui.fs" />
    <Compile Include="Link.fs" />
    <Compile Include="Widgets.fs" />
    <Compile Include="App.fs" />
  </ItemGroup>
  <Import Project="..\..\..\.paket\Paket.Restore.targets" />
</Project>
