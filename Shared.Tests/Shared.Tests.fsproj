<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Run with: dotnet run, project Shared.Tests. The Shared codecs against messages and files
       taken from the real code and data of this repository. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mecaviv.Shared.Tests</RootNamespace>
    <NoWarn>$(NoWarn);NU1510;</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.fsproj" />
    <Compile Include="TestJson.fs" />
    <Compile Include="JsonTests.fs" />
    <Compile Include="ConsoleTests.fs" />
    <Compile Include="ConfigTests.fs" />
    <Compile Include="PureDataFramesTests.fs" />
    <Compile Include="PresetSyncTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>
