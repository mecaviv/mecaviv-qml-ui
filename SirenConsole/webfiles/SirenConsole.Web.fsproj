<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SirenConsole.Web</RootNamespace>
    <AssemblyName>sirenconsole-web</AssemblyName>
    <NoWarn>$(NoWarn);NU1510;</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**;**/*.wasm</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Infrastructure\Infrastructure.fsproj" />
    <ProjectReference Include="..\..\Shared\Shared.fsproj" />
    <Compile Include="Presets.fs" />
    <Compile Include="ConsoleConfig.fs" />
    <Compile Include="UiSocket.fs" />
    <Compile Include="PupitreLinks.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
